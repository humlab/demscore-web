{
  "defaults": {
    "title": "Quantile class, country-year",
    "low": "Lower value",
    "high": "Higher value",
    "note": "Colours show relative rank for the selected year.",
    "direction": "low-to-high"
  },
  "dataset_defaults": {
    "v_dem": {
      "low": "Lower democratic performance",
      "high": "Higher democratic performance",
      "note": "For most V-Dem indicators here, higher values indicate stronger democratic performance.",
      "direction": "low-to-high"
    }
  },
  "rules": [
    {
      "dataset": "v_dem",
      "match": "(?:_sd|_osp_sd|_nr)$",
      "low": "Lower value",
      "high": "Higher value",
      "note": "These V-Dem variants describe model uncertainty or respondent diagnostics, not democratic performance.",
      "direction": "low-to-high"
    },
    {
      "dataset": "v_dem",
      "match": "^v2meharjrn(?:_|$)",
      "low": "More harassment",
      "high": "Less / no harassment",
      "lowMeans": "No journalist dares offend powerful actors",
      "highMeans": "Journalists are never harassed",
      "note": "",
      "takeaway": "Higher means less harassment.",
      "direction": "low-to-high"
    },
    {
      "dataset": "v_dem",
      "match": "^v2mecenefm(?:_|$)",
      "low": "More censorship",
      "high": "Less censorship",
      "lowMeans": "Censorship is direct and routine",
      "highMeans": "The government rarely attempts to censor",
      "note": "",
      "takeaway": "Higher means less censorship.",
      "direction": "low-to-high"
    },
    {
      "dataset": "v_dem",
      "match": "^v2jupoatck(?:_|$)",
      "low": "More attacks",
      "high": "Fewer / no attacks",
      "lowMeans": "Attacks on the judiciary daily or weekly",
      "highMeans": "No attacks",
      "note": "",
      "takeaway": "Higher means fewer attacks.",
      "direction": "low-to-high"
    },
    {
      "dataset": "v_dem",
      "match": "^v2smgovdom(?:_|$)",
      "low": "More false information",
      "high": "Less false information",
      "lowMeans": "The government spreads false information extremely often",
      "highMeans": "Never or almost never",
      "note": "",
      "takeaway": "Higher means less false information.",
      "direction": "low-to-high"
    },
    {
      "dataset": "v_dem",
      "match": "^v2exbribe(?:_|$)",
      "low": "More bribery",
      "high": "Less bribery",
      "lowMeans": "Bribery is routine and expected",
      "highMeans": "Never or hardly ever",
      "note": "",
      "takeaway": "Higher means less bribery.",
      "direction": "low-to-high"
    }
  ]
}
